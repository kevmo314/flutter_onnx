diff --git a/packages/on_device_tts/ios/on_device_tts/OnDeviceTtsCore/Tests/OnDeviceTtsCoreTests/ReferenceGraph.swift b/packages/on_device_tts/ios/on_device_tts/OnDeviceTtsCore/Tests/OnDeviceTtsCoreTests/ReferenceGraph.swift
