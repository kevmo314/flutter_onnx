diff --git a/packages/on_device_tts/ios/on_device_tts/OnDeviceTtsCore/Sources/OnDeviceTtsCore/Supertonic/GraphSession.swift b/packages/on_device_tts/ios/on_device_tts/OnDeviceTtsCore/Sources/OnDeviceTtsCore/Supertonic/GraphSession.swift
